# A frame that lost its network says so, and its own Wi-Fi closes in time
# (usr/local/sbin/frame-wifi-watch).
[Unit]
Description=The frame's network, watched
RequiresMountsFor=/data
After=frame-wifi.service frame-wpa.service

[Service]
ExecStart=/usr/local/sbin/frame-wifi-watch
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
