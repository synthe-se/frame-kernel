# What the interface, as kiosk, may ask of the Wi-Fi: root, a socket of group kiosk in its own
# directory (tools: frame-wifid). Keeps running while wpa_supplicant restarts.
[Unit]
Description=The frame's Wi-Fi, for its interface
RequiresMountsFor=/data
After=frame-wifi.service

[Service]
Group=kiosk
ExecStart=/usr/local/bin/frame-wifid
RuntimeDirectory=frame-wifi
RuntimeDirectoryMode=0750
Restart=always
RestartSec=2
# what it may reach: wifi.conf, and wpa_supplicant's socket
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/frame
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
