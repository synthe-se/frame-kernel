#!/bin/sh
# What the frame keeps on its data partition (frame-data.service), under /data/frame: the slots,
# the clock, the journal, the SSH host key, the Wi-Fi it joined. And the partition itself at its
# full size: a frame's first image is smaller than its eMMC, grown here once, mounted.
set -eu
keep=/data/frame
device=$(awk '$2 == "/data" { print $1 }' /proc/mounts | head -1)
if [ -b "$device" ]; then
	sectors=$(cat "/sys/class/block/${device#/dev/}/size")
	held=$(df -k /data | awk 'NR == 2 { print $2 }')
	# a filesystem under nine tenths of its partition was made for a smaller one
	[ "$held" -ge $((sectors * 9 / 20)) ] || resize2fs "$device" >/dev/null 2>&1 || echo "frame-data: $device could not be grown" >&2
fi
install -d -o root -g root -m 0755 "$keep"
install -d -o systemd-timesync -g systemd-timesync -m 0755 "$keep/timesync"
# its clock file too: the user's number changes with the system
chown -R systemd-timesync:systemd-timesync "$keep/timesync"
install -d -o root -g systemd-journal -m 2755 "$keep/journal"
install -d -o root -g root -m 0700 "$keep/ssh"
test -s "$keep/ssh/ssh_host_ed25519_key" || ssh-keygen -q -t ed25519 -N "" -C "$(cat /etc/hostname)" -f "$keep/ssh/ssh_host_ed25519_key"
