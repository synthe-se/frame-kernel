#!/bin/sh
# What wpa_supplicant reads (frame-wpa.service) (/etc and /run are tmpfs: rebuilt at every boot, never written to
# the eMMC). The network the frame joined, else the ones Android knows, with only the keys both
# supplicants read the same way; none: wpa_supplicant still runs, for the product to scan
# (frame-wifid). Only frame-hotspot makes the frame its own Wi-Fi: named after the product and
# locked from its eMMC's serial, what the product shows, the last resort of a dead touch panel.
# What the last boot learnt of the network ($known, frame-commit's) is taken for granted while it
# may be: the channel its access point was on is the only one scanned (a second and a half less),
# and the address it was lent is the frame's from the moment it joins, while the lease lasts and
# DHCP asks again beside it (two seconds less). Both are a guess: frame-wpa widens the scan when
# nothing answers there, frame-commit forgets a lease the network no longer gives.
set -eu
own=/android-data/frame/wifi.conf
android=/android-data/misc/wifi/wpa_supplicant.conf
out=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
hotspot=/run/frame-hotspot
known=/android-data/frame/wifi.known
wide=/run/frame-wifi-wide
guess=/run/systemd/network/40-wlan0-known.network
umask 077
mkdir -p /etc/wpa_supplicant

networks() {
	if [ -s "$own" ]; then
		cat "$own"
	elif [ -s "$android" ]; then
		awk '
			/^network=\{/ { inside = 1; print; next }
			inside && /^\}/ { inside = 0; print; next }
			inside {
				key = $0; sub(/^[ \t]*/, "", key); sub(/=.*/, "", key)
				if (key ~ /^(ssid|psk|key_mgmt|priority|scan_ssid|proto|pairwise|group|ieee80211w)$/) print
			}
		' "$android"
	fi
}

said() { sed -n "s/^$1=//p" "$known" 2>/dev/null | head -1; }
rm -f "$guess"
if [ ! -e "$hotspot" ]; then
	freq=$(said freq)
	case "$freq" in *[!0-9]* | "") freq= ;; esac
	[ ! -e "$wide" ] || freq=
	printf 'ctrl_interface=/run/wpa_supplicant\ncountry=FR\np2p_disabled=1\n%s\n' "$(networks)" |
		if [ -n "$freq" ]; then sed "s/^network={\$/network={\n\tscan_freq=$freq/"; else cat; fi >"$out"
	# the lease, while it lasts and for that network alone: a name and numbers of the expected
	# shape, or nothing
	ssid=$(said ssid) address=$(said address) router=$(said router) until=$(said until)
	case "$ssid" in *[!A-Za-z0-9\ _.-]* | "") ssid= ;; esac
	case "$address$router" in *[!0-9./]* | "") ssid= ;; esac
	case "$until" in *[!0-9]* | "") ssid= ;; esac
	if [ -n "$ssid" ] && [ -n "$freq" ] && [ "$(date +%s)" -lt "$until" ]; then
		mkdir -p /run/systemd/network
		chmod 755 /run/systemd/network
		printf '[Match]\nName=wlan0\nSSID=%s\n\n[Network]\nDHCP=yes\nMulticastDNS=yes\nAddress=%s\nGateway=%s\n' "$ssid" "$address" "$router" >"$guess"
		for dns in $(said dns); do case "$dns" in *[!0-9a-fA-F.:]*) ;; *) echo "DNS=$dns" >>"$guess" ;; esac; done
		chmod 644 "$guess"
	fi
	echo "frame-wifi: $(grep -c '^network=' "$out" || :) network(s)"
	exit 0
fi

serial=$(sha256sum /sys/block/mmcblk0/device/cid | cut -c1-64)
ssid=$(cat /etc/frame/name)-$(echo "$serial" | cut -c1-4)
password=$(echo "$serial" | cut -c5-16)
printf 'ctrl_interface=/run/wpa_supplicant\ncountry=FR\nap_scan=2\nnetwork={\n\tssid="%s"\n\tmode=2\n\tfrequency=2437\n\tkey_mgmt=WPA-PSK\n\tproto=RSN\n\tpairwise=CCMP\n\tgroup=CCMP\n\tpsk="%s"\n}\n' "$ssid" "$password" >"$out"
printf 'FRAME_SETUP_SSID=%s\nFRAME_SETUP_PASSWORD=%s\nFRAME_SETUP_URL=http://192.168.4.1\n' "$ssid" "$password" >/run/frame-setup
chmod 644 /run/frame-setup
# networkd's user reads it, whatever this script's umask
mkdir -p /run/systemd/network
chmod 755 /run/systemd/network
printf '[Match]\nName=wlan0\n\n[Network]\nAddress=192.168.4.1/24\nDHCPServer=yes\n' >/run/systemd/network/40-frame-setup.network
chmod 644 /run/systemd/network/40-frame-setup.network
systemctl --no-block start frame-setup 2>/dev/null || :
echo "frame-wifi: its own Wi-Fi, as $ssid"
